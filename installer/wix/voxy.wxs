<?xml version="1.0" encoding="windows-1252"?>
<!--
    VOXY MSI Installer — WiX Configuration
    Builds standard Windows Installer for VOXY Desktop & Daemon
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product
    Id="*"
    Name="VOXY"
    Language="1033"
    Version="0.1.0"
    Manufacturer="VOXY Engineering Team"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

    <Package
      InstallerVersion="200"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      Description="VOXY Commercial AI Operating Companion"
      Manufacturer="VOXY Engineering Team"
      Comments="Voice-first autonomous Windows companion" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of VOXY is already installed." />

    <Media Id="1" Cabinet="voxy.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1" />
    <Property Id="DiskPrompt" Value="VOXY Installation" />

    <Property Id="ARPHELPLINK" Value="https://github.com/gaurav-xdev/VOXY-COMMERCIAL" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/gaurav-xdev/VOXY-COMMERCIAL" />

    <Feature
      Id="MainProgram"
      Title="VOXY Application"
      Description="Installs the VOXY Desktop UI and Background Runtime Daemon."
      Level="1"
      ConfigurableDirectory="INSTALLDIR"
      AllowAdvertise="no"
      Display="hidden">
      <ComponentRef Id="DaemonComponent" />
      <ComponentRef Id="DesktopUiComponent" />
      <ComponentRef Id="ConfigDirComponent" />
      <ComponentRef Id="LogsDirComponent" />
      <ComponentRef Id="StartMenuShortcuts" />
    </Feature>

    <Feature
      Id="DesktopShortcut"
      Title="Desktop Shortcut"
      Description="Creates a desktop shortcut for VOXY."
      Level="1"
      AllowAdvertise="no"
      Absent="allow">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="VOXY">
          <Component Id="DaemonComponent" Guid="A769D71C-7B62-4C3D-882E-4EF015B2A044" Win64="yes">
            <File
              Id="voxy_daemon_exe"
              Name="voxy-daemon.exe"
              DiskId="1"
              Source="target\release\voxy-daemon.exe"
              KeyPath="yes" />
          </Component>
          <Component Id="DesktopUiComponent" Guid="F1492B14-BEE2-4919-8664-C38BE98E9FA5" Win64="yes">
            <File
              Id="voxy_desktop_ui_exe"
              Name="voxy-desktop-ui.exe"
              DiskId="1"
              Source="target\release\voxy-desktop-ui.exe"
              KeyPath="yes" />
          </Component>
          <Directory Id="ConfigDir" Name="config">
            <Component Id="ConfigDirComponent" Guid="C8E9B611-3E5A-4DFB-8833-2895FFCC5121" Win64="yes">
              <CreateFolder Directory="ConfigDir" />
              <Environment
                Id="PATH"
                Name="PATH"
                Value="[INSTALLDIR]"
                Permanent="no"
                Part="last"
                Action="set"
                System="yes" />
            </Component>
          </Directory>
          <Directory Id="LogsDir" Name="logs">
            <Component Id="LogsDirComponent" Guid="DB486B2E-3088-4217-BA0E-16B4DECC3F19" Win64="yes">
              <CreateFolder Directory="LogsDir" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="VOXY">
          <Component Id="StartMenuShortcuts" Guid="6BD4D8A2-E8DF-4CA9-A1B3-4DF837E17F1C">
            <Shortcut
              Id="UiStartMenuShortcut"
              Name="VOXY"
              Description="VOXY Commercial AI Operating Companion"
              Target="[INSTALLDIR]voxy-desktop-ui.exe"
              WorkingDirectory="INSTALLDIR" />
            <Shortcut
              Id="DaemonStartMenuShortcut"
              Name="VOXY Background Runtime"
              Description="VOXY AI Background Runtime Daemon"
              Target="[INSTALLDIR]voxy-daemon.exe"
              WorkingDirectory="INSTALLDIR" />
            <Shortcut
              Id="UninstallShortcut"
              Name="Uninstall VOXY"
              Description="Uninstall VOXY"
              Target="[System64Folder]msiexec.exe"
              Arguments="/x [ProductCode]" />
            <RemoveFolder
              Id="CleanupShortcuts"
              Directory="ApplicationProgramsFolder"
              On="uninstall" />
            <RegistryValue
              Root="HKCU"
              Key="Software\VOXY\Shortcuts"
              Name="StartMenu"
              Type="integer"
              Value="1"
              KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder">
        <Component Id="DesktopShortcutComponent" Guid="E64FDE61-89B7-4A1C-98A6-302E9A68361B">
          <Shortcut
            Id="DesktopShortcut"
            Name="VOXY"
            Description="VOXY Commercial AI Operating Companion"
            Target="[INSTALLDIR]voxy-desktop-ui.exe"
            WorkingDirectory="INSTALLDIR" />
          <RegistryValue
            Root="HKCU"
            Key="Software\VOXY\Shortcuts"
            Name="Desktop"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize" />

  </Product>
</Wix>
