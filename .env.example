# ==============================================================================
# VOXY Enterprise Production Configuration Template (.env.example)
# Copy this file to .env and populate with your production credentials.
# NEVER commit the .env file containing real API keys or secrets to git.
# ==============================================================================

# ==============================================================================
# 1. CORE APPLICATION & DESKTOP RUNTIME
# ==============================================================================
# Windows Named Pipe IPC Authentication Token (Shared secret between UI and Daemon)
VOXY_IPC_AUTH_TOKEN=your_secure_ipc_token_here

# Voice Admin & Observability Dashboard REST API port (default: 8088)
VOXY_VOICE_ADMIN_PORT=8088

# Routing and Quota Engine Settings:
# Options: "conservative" (preserves quota, prefers low-cost tiers, strict 40% safety margin)
#          "balanced"     (production default, balanced speed/cost/health scoring, 35% safety margin)
#          "performance"  (prioritizes lowest latency, 15% safety margin)
VOXY_VOICE_ROUTING_MODE=balanced

# Global default safety margin (0.10 to 0.50, default 0.35 = 35% headroom below hard limits)
VOXY_VOICE_SAFETY_MARGIN=0.35

# Voice Operation Mode (Offline Fallback Control):
# auto  - Cloud-first with automatic local offline fallback on failure/timeout (default)
# cloud - Cloud-only providers (fails if internet/cloud is unreachable)
# local - Strict offline mode (100% on-device, zero outbound network calls, zero API keys required)
VOICE_MODE=auto

# Speculative LLM execution for ultra-low latency voice responses (true/false)
VOXY_SPECULATIVE_LLM=false

# Max context length in characters passed into LLM prompt
VOXY_LLM_CONTEXT_CHARS=6000

# Logging & Tracing Filters
RUST_LOG=info,voxy_voxray=debug,voxy_voice=info,voxy_desktop_ui=info


# ==============================================================================
# 2. LLM BRAIN PROVIDERS
# ==============================================================================
# Active LLM Provider Selection:
# Options: "ollama" (default local), "openai", "anthropic", "gemini", "groq", "openrouter"
VOXY_LLM_PROVIDER=ollama

# --- Local / Self-Hosted (Ollama) ---
VOXY_OLLAMA_URL=http://127.0.0.1:11434
VOXY_OLLAMA_MODEL=gpt-oss:120b-cloud

# --- OpenAI Cloud ---
VOXY_API_KEYS_OPENAI=your_openai_api_key_here
VOXY_OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude ---
VOXY_API_KEYS_ANTHROPIC=your_anthropic_api_key_here
VOXY_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Google Gemini ---
VOXY_API_KEYS_GEMINI=your_gemini_api_key_here
VOXY_GEMINI_MODEL=gemini-2.0-flash

# --- Groq Fast Inference ---
# Uses VOXY_API_KEYS_OPENAI or Groq key
VOXY_GROQ_MODEL=openai/gpt-oss-20b

# --- OpenRouter Multi-Model Router ---
VOXY_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet


# ==============================================================================
# 3. SPEECH-TO-TEXT (STT) CLOUD PROVIDERS
# ==============================================================================
# 1. Groq Whisper Large V3 Turbo (Default high-speed STT ~220ms, multilingual, low cost)
STT_GROQ_API_KEY=your_groq_api_key_here
# STT_GROQ_MODEL=whisper-large-v3-turbo

# 2. Deepgram Nova-2 (Ultra-fast streaming WebSocket/REST STT ~180ms)
STT_DEEPGRAM_API_KEY=your_deepgram_api_key_here
# STT_DEEPGRAM_MODEL=nova-2

# 3. ElevenLabs Scribe STT
STT_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# STT_ELEVENLABS_MODEL=scribe_v1

# 4. AssemblyAI STT
STT_ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# 5. Microsoft Azure Cognitive Services Speech STT
STT_AZURE_API_KEY=your_azure_speech_key_here
STT_AZURE_REGION=eastus

# 6. Google Cloud Speech-to-Text STT
STT_GOOGLE_API_KEY=your_google_cloud_api_key_here
# STT_GOOGLE_MODEL=chirp_2


# ==============================================================================
# 4. TEXT-TO-SPEECH (TTS) CLOUD PROVIDERS
# ==============================================================================
# 1. Cartesia Sonic TTS (Ultra-low latency streaming voice ~100ms)
CARTESIA_ENABLED=true
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=your_cartesia_voice_id_here
# CARTESIA_MODEL_ID=sonic-english

# 2. ElevenLabs Neural TTS (Ultra-realistic streaming voice)
TTS_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
TTS_ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
# TTS_ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# 3. OpenAI TTS (tts-1 / tts-1-hd)
TTS_OPENAI_API_KEY=your_openai_api_key_here
TTS_OPENAI_VOICE=alloy
TTS_OPENAI_MODEL=tts-1

# 4. Deepgram Aura TTS (Ultra-low latency streaming ~150ms)
TTS_DEEPGRAM_API_KEY=your_deepgram_api_key_here
TTS_DEEPGRAM_MODEL=aura-asteria-en

# 5. Microsoft Azure Neural TTS
TTS_AZURE_API_KEY=your_azure_speech_key_here
TTS_AZURE_REGION=eastus
TTS_AZURE_VOICE=en-US-JennyNeural

# 6. Google Cloud Text-to-Speech
TTS_GOOGLE_API_KEY=your_google_cloud_api_key_here
TTS_GOOGLE_VOICE=en-US-Journey-F

# 7. Chatterbox Hinglish TTS Microservice
TTS_CHATTERBOX_ENDPOINT=http://127.0.0.1:5002/v1/audio/speech


# ==============================================================================
# 5. DODO PAYMENTS & BILLING INTEGRATION
# ==============================================================================
# Dodo Payments API Key (Live or Test)
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key_here

# Environment mode: "live" / "production" or "test" (default: "test")
DODO_PAYMENTS_ENVIRONMENT=test

# Standard Webhooks HMAC-SHA256 Secret (Used to cryptographically verify billing webhooks)
# Format typically starts with "whsec_..."
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_webhook_secret_here


# ==============================================================================
# 6. TRANSACTIONAL EMAIL (RESEND)
# ==============================================================================
# Resend API Key for transactional notifications, user verification, and welcome emails
RESEND_API_KEY=your_resend_api_key_here

# Verified Sender Email Address (e.g. "OSMOO <noreply@osmoo.in>")
RESEND_FROM_EMAIL=OSMOO <noreply@osmoo.in>


# ==============================================================================
# 7. OPTIONAL PROVIDER RATE LIMIT & CONCURRENCY OVERRIDES
# ==============================================================================
# Safe RPM and active concurrency limits are calculated automatically with safety margins.
# You can customize limits per provider if needed:
# ELEVENLABS_RPM_LIMIT=20
# ELEVENLABS_CONCURRENCY_LIMIT=3
# AZURE_TTS_RPM_LIMIT=120
# AZURE_TTS_CONCURRENCY_LIMIT=10
# GOOGLE_TTS_RPM_LIMIT=150
# GOOGLE_TTS_CONCURRENCY_LIMIT=10
# OPENAI_TTS_RPM_LIMIT=50
# OPENAI_TTS_CONCURRENCY_LIMIT=4
# DEEPGRAM_TTS_RPM_LIMIT=150
# DEEPGRAM_TTS_CONCURRENCY_LIMIT=10
# CHATTERBOX_TTS_RPM_LIMIT=30
# CHATTERBOX_TTS_CONCURRENCY_LIMIT=2
# CARTESIA_RPM_LIMIT=60
# CARTESIA_CONCURRENCY_LIMIT=5
